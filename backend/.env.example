# Copy to .env and fill in local values. Never commit the real .env file.

NODE_ENV=development
PORT=3001

# PostgreSQL connection for this service's own commercial database.
# Must NOT point at clinic-platform's database.
DATABASE_URL="postgresql://eutech_user:CHANGE_ME@127.0.0.1:5432/eutech_platform?schema=public"

# CORS: the frontend origin(s) allowed to call this API with credentials.
# Comma-separated -- e.g. add a Laragon-style pretty domain alongside the raw dev port.
FRONTEND_ORIGIN="http://localhost:3000,http://eutech-platform.test,https://eutech-platform.test"

# JWT signing. Generate real secrets locally; never reuse the placeholder in any real environment.
JWT_ACCESS_SECRET="CHANGE_ME_ACCESS_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_SECRET"
JWT_REFRESH_TTL="30d"

# Billing provider: LemonSqueezy. Leave blank in local/dev to force the fake provider
# and keep real checkout disabled with a clear configuration error.
BILLING_PROVIDER="fake"
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# clinic-platform provisioning integration (proposed contract; not yet implemented
# on the clinic-platform side). Leave PROVISIONING_ADAPTER=mock until it exists.
PROVISIONING_ADAPTER="mock"
CLINIC_PLATFORM_PROVISIONING_BASE_URL=""
CLINIC_PLATFORM_PROVISIONING_SERVICE_TOKEN=""
# How long the mock adapter simulates "provisioning in progress" before
# reporting ready. Lower this for faster local testing.
MOCK_PROVISIONING_DELAY_MS=3000
